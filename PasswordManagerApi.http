@PasswordManagerApi_HostAddress = http://localhost:5103
@jwtToken = REPLACE_WITH_TOKEN

GET {{PasswordManagerApi_HostAddress}}/
Accept: application/json

###

POST {{PasswordManagerApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "demo",
  "password": "demo123"
}

###

POST {{PasswordManagerApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "demo",
  "password": "demo123"
}

###

GET {{PasswordManagerApi_HostAddress}}/api/passwords
Authorization: Bearer {{jwtToken}}
Accept: application/json

###

POST {{PasswordManagerApi_HostAddress}}/api/passwords
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "title": "Gmail",
  "password": "mypassword123",
  "loginUsername": "demo@gmail.com",
  "website": "https://mail.google.com",
  "notes": "personal email"
}

###

# Password Strength Validation Tests

### Test 1: Weak password registration (should fail)
POST {{PasswordManagerApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser1",
  "password": "weak"
}

###

### Test 2: Common password registration (should fail)
POST {{PasswordManagerApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser2",
  "password": "password123"
}

###

### Test 3: Medium strength password registration (should succeed)
POST {{PasswordManagerApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser3",
  "password": "Medium123!"
}

###

### Test 4: Strong password registration (should succeed)
POST {{PasswordManagerApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser4",
  "password": "VeryStr0ng!Pass@2024"
}

###

### Test 5: Create password entry with weak password (should succeed with warning)
POST {{PasswordManagerApi_HostAddress}}/api/passwords
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "title": "Test Weak",
  "password": "weak123",
  "loginUsername": "test@example.com"
}

###

### Test 6: Create password entry with strong password
POST {{PasswordManagerApi_HostAddress}}/api/passwords
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "title": "Test Strong",
  "password": "MyStr0ng!P@ssw0rd",
  "loginUsername": "test@example.com"
}

###

### Test 7: Update password entry
PUT {{PasswordManagerApi_HostAddress}}/api/passwords/1
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "password": "Updated!Str0ng@Pass"
}

###
